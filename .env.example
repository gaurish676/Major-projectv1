# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Authentication
# In production, use a high-entropy 256-bit secret (e.g. openssl rand -base64 32)
JWT_SECRET=creditz_production_high_entropy_jwt_secret_2026_nmamit_autonomous

# Database
AUTO_SEED=false

# Google Gemini API Configuration (Multimodal Vision & GraphRAG Advisor)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage Configuration (local | s3 | minio | r2)
STORAGE_PROVIDER=local
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=creditz-certificates
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
